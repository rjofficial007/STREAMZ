<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/streamz_splash_background" />
    <item>
        <shape>
            <gradient
                android:type="radial"
                android:gradientRadius="520dp"
                android:centerX="50%"
                android:centerY="0%"
                android:startColor="#D90C3AA8"
                android:centerColor="#400C3AA8"
                android:endColor="#00060606" />
        </shape>
    </item>
    <item>
        <bitmap
            android:src="@drawable/streamz_app_icon"
            android:gravity="center" />
    </item>
</layer-list>
